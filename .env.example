# Postgres connection string. On Render, copy this from the Postgres instance's
# "Internal Database URL". For local dev without Postgres installed, you can leave
# this unset and the app falls back to a local SQLite file (sqlite:///./local.db).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared PIN the admin types to log into the dashboard. Change this before the event.
ADMIN_PIN=change-me

# Random secret used to sign the admin's login cookie. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SECRET=change-me-too

# Comma-separated list of origins allowed to call /api/*. "*" is fine for the public
# game-facing API since no secrets flow through it (see backend/app/main.py).
CORS_ORIGINS=*
